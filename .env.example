# Copy to .env.local for local development, or set in your hosting provider.

# --- Branding & site (public) -------------------------------------------
# Production URL — enables canonical URLs, sitemap entries and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STUDIO_NAME="Studio Name"
NEXT_PUBLIC_STUDIO_SHORT_NAME="Studio"
NEXT_PUBLIC_FOUNDER_NAME="Founder Name"
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Optional scheduling link (Cal.com, Calendly…) shown on the contact page.
NEXT_PUBLIC_BOOKING_URL=

# --- Contact form delivery (server-only — never prefix with NEXT_PUBLIC) --
# Configure at least one channel. With none, the form clearly tells visitors
# that online inquiries are not connected and nothing is sent.

# Option 1: email via Resend (https://resend.com)
RESEND_API_KEY=
# Comma-separated list of recipients
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Studio Website <inquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Option 2: webhook (Zapier, Make, n8n, CRM, …) — receives a JSON POST
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header
CONTACT_WEBHOOK_SECRET=
