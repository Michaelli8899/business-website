# Frame & Flow Studio — environment variables
#
# VITE_* values are PUBLIC: they are compiled into the website at build time.
# Never put API keys or other secrets in a VITE_* variable.
# Copy to .env.local for local development. On GitHub Pages, set them as
# repository Variables (see .github/workflows/deploy-pages.yml).

# --- Website build (public) -----------------------------------------------
# Path the site is served under: "/business-website" for the GitHub Pages
# project site, empty for a custom domain. Set automatically in the workflow.
VITE_BASE_PATH=
# Public site URL (enables canonical URLs, sitemap, absolute OG URLs).
# Set automatically in the workflow. No custom domain has been chosen yet.
VITE_SITE_URL=
# true = noindex + robots disallow (used for the GitHub Pages test deployment)
VITE_NOINDEX=false

# Contact form backend URL (e.g. the deployed server/contact-handler.ts).
# Empty = the form shows a "not connected" notice and an email fallback.
VITE_CONTACT_ENDPOINT=

# Social profiles — hidden unless a full https profile URL is provided.
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_GITHUB_URL=
VITE_BOOKING_URL=

# Privacy policy
VITE_PRIVACY_LAST_UPDATED=
VITE_PRIVACY_REVIEWED=false
# Hosting provider named in the privacy policy
VITE_HOSTING_PROVIDER="GitHub Pages, a service of GitHub, Inc."

# --- Contact function (SERVER-ONLY: set on the function host, not here) ---
# These are read by server/contact-handler.ts where it is deployed, e.g. as
# Vercel/Netlify environment variables. They never belong in the website build.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=michaelmlidesign@gmail.com
# CONTACT_FROM_EMAIL="Frame & Flow Studio <inquiries@your-verified-domain>"
# CONTACT_ALLOW_TEST_SENDER=false
# ALLOWED_ORIGINS=https://michaelli8899.github.io
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
