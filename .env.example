# Frame & Flow Studio — environment variables
# Copy to .env.local for local development, or set in your hosting provider.
# Studio identity (name, founder, public email, location) lives in
# src/config/site.ts and does not need environment variables.

# --- Site URL (public) ----------------------------------------------------
# No production domain has been selected yet. Leave empty until one is.
# When empty: no canonical URLs or sitemap entries are generated. On Vercel
# production deployments the project's production domain is used instead.
# Example once chosen: NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# --- Social profiles (public, optional) -----------------------------------
# Hidden unless set to a full https profile URL on the matching domain.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# Optional scheduling link (Cal.com, Calendly…) shown on the contact page.
NEXT_PUBLIC_BOOKING_URL=

# --- Privacy policy (public) ----------------------------------------------
# Publication date shown on /privacy, e.g. "January 15, 2027". Set at launch.
NEXT_PUBLIC_PRIVACY_LAST_UPDATED=
# Set to true after owner/legal review to remove the "pending review" notice.
NEXT_PUBLIC_PRIVACY_REVIEWED=false

# --- Contact form delivery via Resend (SERVER-ONLY — never NEXT_PUBLIC_) --
RESEND_API_KEY=
# Recipient(s), comma-separated. Defaults to michaelmlidesign@gmail.com.
CONTACT_TO_EMAIL=michaelmlidesign@gmail.com
# Sender on a domain verified in Resend. Required for production.
# Example once a domain is verified: "Frame & Flow Studio <inquiries@your-domain.com>"
CONTACT_FROM_EMAIL=
# Development only: allow Resend's test sender (onboarding@resend.dev) when
# CONTACT_FROM_EMAIL is empty. Resend only delivers test-sender mail to the
# email address that owns the Resend account. Always on under `next dev`.
CONTACT_ALLOW_TEST_SENDER=false

# --- Shared rate limiting (SERVER-ONLY, recommended for serverless) -------
# Upstash Redis REST credentials. Without these, an in-memory limiter is
# used, which is not reliable across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
